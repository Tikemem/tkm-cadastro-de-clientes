<Application
    x:Class="CadastroClientes.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>

                <!-- ===== TEMA CLARO ===== -->
                <ResourceDictionary x:Key="Light">
                    <!-- Cores da aplicação -->
                    <SolidColorBrush x:Key="CardBrush"          Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BorderSoftBrush"    Color="#E2E8F0" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="HeaderRowBrush"     Color="#16325C" />
                    <SolidColorBrush x:Key="DangerBrush"        Color="#DC2626" />
                    <SolidColorBrush x:Key="LogoBgBrush"        Color="#16325C" />
                    <SolidColorBrush x:Key="LogoFgBrush"        Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SubtleBgBrush"      Color="#F3F4F6" />

                    <!-- Hover dos botões padrão WinUI (claro → cinza suave) -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                     Color="#E5E7EB" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                     Color="#111827" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                     Color="#D1D5DB" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed"
                                     Color="#111827" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                     Color="#D1D5DB" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                     Color="#9CA3AF" />
                </ResourceDictionary>

                <!-- ===== TEMA ESCURO – cinza escuro / cinza claro ===== -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Cores da aplicação -->
                    <SolidColorBrush x:Key="CardBrush"          Color="#2D2D2D" />
                    <SolidColorBrush x:Key="BorderSoftBrush"    Color="#484848" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA" />
                    <SolidColorBrush x:Key="HeaderRowBrush"     Color="#1A1A1A" />
                    <SolidColorBrush x:Key="DangerBrush"        Color="#EF4444" />
                    <SolidColorBrush x:Key="LogoBgBrush"        Color="#383838" />
                    <SolidColorBrush x:Key="LogoFgBrush"        Color="#E0E0E0" />
                    <SolidColorBrush x:Key="SubtleBgBrush"      Color="#232323" />

                    <!-- Hover dos botões padrão WinUI (escuro → cinza médio) -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                     Color="#484848" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"
                                     Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                     Color="#555555" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed"
                                     Color="#F0F0F0" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"
                                     Color="#606060" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"
                                     Color="#707070" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
