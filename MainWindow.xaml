<Window
    x:Class="CadastroClientes.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Content>
        <Grid x:Name="Raiz" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24,16,24,14" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══════════════ CABEÇALHO COM LOGO ═══════════════ -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">

                <!-- Logo TKM -->
                <Border Grid.Column="0"
                        Background="{ThemeResource LogoBgBrush}"
                        CornerRadius="10"
                        Width="52" Height="52"
                        VerticalAlignment="Center">
                    <!-- Ícone SVG / Path: 'T' estilizado com traço duplo -->
                    <Canvas Width="52" Height="52">
                        <!-- Letra T bold -->
                        <Path Fill="{ThemeResource LogoFgBrush}"
                              Data="M14,14 L38,14 L38,19 L29,19 L29,38 L23,38 L23,19 L14,19 Z" />
                        <!-- Linha decorativa inferior -->
                        <Rectangle Canvas.Left="10" Canvas.Top="40"
                                   Width="32" Height="3"
                                   RadiusX="1.5" RadiusY="1.5"
                                   Fill="#2563EB" />
                        <!-- Ponto decorativo (K) -->
                        <Ellipse Canvas.Left="34" Canvas.Top="23"
                                 Width="6" Height="6"
                                 Fill="#2563EB" />
                    </Canvas>
                </Border>

                <!-- Título e subtítulo -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="TxtTitulo"
                               Style="{StaticResource TitleTextBlockStyle}"
                               FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="TxtSubtitulo"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>

                <!-- Controles do canto direito: Ko-fi + idioma + tema -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                    <!-- Botão Ko-fi: estilizado com as cores e hover do tema ativo -->
                    <Button x:Name="BtnKofi"
                            VerticalAlignment="Center"
                            Click="BtnKofi_Click"
                            ToolTipService.ToolTip="Apoie no Ko-fi (ko-fi.com/tikemem)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="☕" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Ko-fi" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Seletor de idioma -->
                    <ComboBox x:Name="CmbIdioma"
                              Width="160"
                              VerticalAlignment="Center"
                              SelectionChanged="CmbIdioma_SelectionChanged"
                              ToolTipService.ToolTip="Language / Idioma">
                        <!-- Items gerados em code-behind -->
                    </ComboBox>

                    <!-- Botão tema -->
                    <Button x:Name="BtnTema"
                            VerticalAlignment="Center"
                            Click="BtnTema_Click" />
                </StackPanel>
            </Grid>

            <!-- ═══════════════ BARRA DE FERRAMENTAS ═══════════════ -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox x:Name="TxtBusca" TextChanged="TxtBusca_TextChanged" />

                <!-- Botões de ação -->
                <StackPanel x:Name="Acoes" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="BtnNovo"   Style="{StaticResource AccentButtonStyle}"  Click="Novo_Click" />
                    <Button x:Name="BtnEditar" Click="Editar_Click" />
                    <Button x:Name="BtnExcluir" Background="{ThemeResource DangerBrush}" Foreground="White" Click="Excluir_Click" />
                    <Button x:Name="BtnImprimir" Click="Imprimir_Click" />
                    <Button x:Name="BtnConfigDrive" Click="ConfigurarDrive_Click" />
                    <Button x:Name="BtnBackup" Click="Backup_Click" />
                    <Button x:Name="BtnRestaurar" Click="Restaurar_Click" />
                </StackPanel>
            </Grid>

            <!-- ═══════════════ LISTA DE CLIENTES ═══════════════ -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource BorderSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*">

                    <!-- Cabeçalho da tabela -->
                    <Grid x:Name="GridCabecalho"
                          Padding="16,10"
                          ColumnDefinitions="3*,2*,2.2*,1.6*,1.6*,0.6*,1.4*"
                          ColumnSpacing="8"
                          Background="{ThemeResource HeaderRowBrush}">
                        <TextBlock x:Name="ColNome"       Grid.Column="0" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="ColDocumento"  Grid.Column="1" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="ColEmail"      Grid.Column="2" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="ColTelefone"   Grid.Column="3" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="ColCidade"     Grid.Column="4" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="ColUf"         Grid.Column="5" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="ColCadastrado" Grid.Column="6" FontWeight="SemiBold" Foreground="White" />
                    </Grid>

                    <!-- Itens -->
                    <ListView x:Name="Lista" Grid.Row="1" SelectionMode="Single"
                              DoubleTapped="Lista_DoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding"   Value="16,0" />
                                <Setter Property="MinHeight" Value="40" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="3*,2*,2.2*,1.6*,1.6*,0.6*,1.4*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Nome}"      TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Documento}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Email}"     TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Telefone}"  TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding Cidade}"    TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{Binding Uf}" />
                                    <TextBlock Grid.Column="6" Text="{Binding Cadastro}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ═══════════════ STATUS ═══════════════ -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ProgressRing x:Name="Progresso" Width="18" Height="18" IsActive="False" />
                <TextBlock x:Name="TxtStatus" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </Grid>
        </Grid>
    </Window.Content>
</Window>
