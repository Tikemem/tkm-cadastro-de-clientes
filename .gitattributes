# Auto detect text files and perform LF normalization
* text=auto
* text=auto eol=lf

*.sln text eol=lf
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.exe binary