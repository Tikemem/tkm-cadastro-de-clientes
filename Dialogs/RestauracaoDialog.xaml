<ContentDialog
    x:Class="CadastroClientes.Dialogs.RestauracaoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Restaurar backup da nuvem"
    PrimaryButtonText="Restaurar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Width="480" Spacing="10">
        <TextBlock x:Name="TxtInfo"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextSecondaryBrush}" />

        <ListView x:Name="Lista"
                  Height="280"
                  SelectionMode="Single"
                  SelectionChanged="Lista_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,6" Spacing="2">
                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Resumo}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
