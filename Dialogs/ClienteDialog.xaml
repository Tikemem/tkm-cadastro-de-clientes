<ContentDialog
    x:Class="CadastroClientes.Dialogs.ClienteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- Expande o limite de largura do ContentDialog de 548px para 880px para caber todas as colunas sem cortes -->
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">840</x:Double>
    </ContentDialog.Resources>

    <!-- Formulário amplo em 2 colunas: sem barra de rolagem e com 100% dos campos visíveis -->
    <StackPanel Width="820" Spacing="8">

        <!-- Mensagem de Erro Geral -->
        <TextBlock x:Name="TxtErro"
                   Foreground="{ThemeResource DangerBrush}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!-- Grid Principal com 2 Colunas Espaçosas -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">

            <!-- ════ COLUNA ESQUERDA: IDENTIFICAÇÃO E DOCUMENTO ════ -->
            <StackPanel Grid.Column="0" Spacing="8">
                <!-- País e Tipo de Documento -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock x:Name="LblPais" FontWeight="SemiBold" FontSize="12" />
                        <ComboBox x:Name="CmbPais"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="CmbPais_SelectionChanged" />
                    </StackPanel>

                    <StackPanel x:Name="PnlTipoDoc" Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="LblTipoDoc" FontWeight="SemiBold" FontSize="12" />
                        <ComboBox x:Name="CmbTipoDoc"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="CmbTipoDoc_SelectionChanged" />
                    </StackPanel>
                </Grid>

                <!-- Sub-país Árabe (visível se Grupo Árabe selecionado) -->
                <StackPanel x:Name="PnlSubPaisArabe" Spacing="3" Visibility="Collapsed">
                    <TextBlock x:Name="LblSubPaisArabe" FontWeight="SemiBold" FontSize="12" />
                    <ComboBox x:Name="CmbSubPaisArabe"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CmbSubPaisArabe_SelectionChanged" />
                </StackPanel>

                <!-- Card Inteligente do Documento -->
                <Border Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource BorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="LblDocOficial"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtBadgePais"
                                       Grid.Column="1"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="TxtDocumento"
                                     Grid.Column="0"
                                     FontSize="13"
                                     FlowDirection="LeftToRight"
                                     TextAlignment="Left"
                                     FontFamily="Consolas, Cascadia Code, Segoe UI"
                                     BeforeTextChanging="TxtDocumento_BeforeTextChanging"
                                     TextChanged="TxtDocumento_TextChanged" />

                            <Border Grid.Column="1"
                                    x:Name="BrdStatusValidacao"
                                    Width="32" Height="32"
                                    CornerRadius="6"
                                    Background="#E5E7EB"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtIconeValidacao"
                                           Text="ℹ"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock x:Name="TxtExemploDoc"
                                   FontSize="10.5"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />

                        <TextBlock x:Name="TxtErroDoc"
                                   FontSize="10.5"
                                   Foreground="{ThemeResource DangerBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="TxtAvisoDoc"
                                   FontSize="10.5"
                                   Foreground="#B45309"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Nome Completo -->
                <TextBox x:Name="TxtNome" />

                <!-- Data de Nascimento e Nacionalidade -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <CalendarDatePicker x:Name="DtNascimento" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="TxtNacionalidade" Grid.Column="1" />
                </Grid>
            </StackPanel>

            <!-- ════ COLUNA DIREITA: CONTATO E ENDEREÇO COMPLETO ════ -->
            <StackPanel Grid.Column="1" Spacing="8">
                <!-- E-mail e Telefone (ambos claramente visíveis) -->
                <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="8">
                    <TextBox x:Name="TxtEmail" />
                    <TextBox x:Name="TxtTelefone" Grid.Column="1" TextChanged="TxtTelefone_TextChanged" />
                </Grid>

                <!-- Endereço: Logradouro e Número (ambos claramente visíveis) -->
                <Grid ColumnDefinitions="2.6*,1*" ColumnSpacing="8">
                    <TextBox x:Name="TxtLogradouro" />
                    <TextBox x:Name="TxtNumero" Grid.Column="1" MaxLength="15" />
                </Grid>

                <!-- Bairro, Cidade e UF/Estado (todos os 3 claramente visíveis) -->
                <Grid ColumnDefinitions="1.2*,1.2*,0.7*" ColumnSpacing="8">
                    <TextBox x:Name="TxtBairro" Grid.Column="0" />
                    <TextBox x:Name="TxtCidade" Grid.Column="1" />
                    <TextBox x:Name="TxtUf" Grid.Column="2" />
                </Grid>

                <!-- Código Postal / CEP -->
                <TextBox x:Name="TxtCep" TextChanged="TxtCep_TextChanged" />

                <!-- Observações (campo aumentado para visualização e escrita confortável) -->
                <TextBox x:Name="TxtObs"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="95" />
            </StackPanel>
        </Grid>

        <!-- Rodapé: Aviso Legal / LGPD / Validação Matemática -->
        <Border Background="{ThemeResource SubtleBgBrush}"
                CornerRadius="6"
                Padding="8,5"
                Margin="0,2,0,0">
            <TextBlock x:Name="TxtDisclaimerLegal"
                       FontSize="10"
                       Foreground="{ThemeResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </Border>

    </StackPanel>
</ContentDialog>
